# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/nexusPlay

# Frontend
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_TIME=7d

# Cookie
COOKIE_EXPIRES_TIME=7

# SMTP / Mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password

# Email
SMTP_FROM_EMAIL=noreply@nexusplay.com
SMTP_FROM_NAME=NexusPlay

# Superadmin seed (used by src/seeder/seeder.js)
SUPERADMIN_EMAIL=admin@nexusplay.gg
SUPERADMIN_PASSWORD=admin123

# Payments - entry-fee checkout
# sandbox: local orders + signature verification, no keys needed, no money moves
# razorpay: Razorpay TEST-mode orders for demo payments (rzp_test_ keys only -
#           rzp_live_ keys are refused so no real money can ever move)
PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_SANDBOX_SECRET=change_me_sandbox_secret